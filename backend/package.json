{
  "name": "party-platform-server",
  "version": "1.0.0",
  "private": true,
  "description": "Authoritative 2-4 player party platform server",
  "main": "dist/backend/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/backend/server.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx game/simulation.test.ts && tsx game/roomManager.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
